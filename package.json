{
  "name": "termpilot",
  "version": "0.8.6",
  "description": "TermPilot - Agent 可操控的终端与图形桌面（SSH / Telnet / 串口 / VNC / RDP）",
  "main": "out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "check:glibc": "node scripts/check-glibc.mjs",
    "rebuild:native": "electron-rebuild -f -o node-pty,@serialport/bindings-cpp",
    "dist": "npm run cli:build && npm run rebuild:native && electron-vite build && electron-builder --publish never",
    "dist:win": "npm run cli:build && npm run rebuild:native && electron-vite build && electron-builder --win --publish never",
    "dist:mac": "npm run cli:build && npm run rebuild:native && electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "npm run cli:build && npm run rebuild:native && electron-vite build && electron-builder --linux --publish never",
    "cli:build": "node scripts/build-cli.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@monaco-editor/react": "^4.7.0",
    "@novnc/novnc": "^1.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "i18next": "^24.2.3",
    "ironrdp-wasm": "^1.3.0",
    "lucide-react": "^1.47.0",
    "material-icon-theme": "^5.38.1",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^15.7.4",
    "serialport": "^13.0.0",
    "shadcn": "^4.21.0",
    "ssh2": "^1.17.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "overrides": {
    "dompurify": "3.4.16"
  },
  "build": {
    "appId": "app.termpilot.desktop",
    "productName": "TermPilot",
    "executableName": "TermPilot",
    "copyright": "Copyright © TermPilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "cli/dist",
        "to": "cli",
        "filter": [
          "termpilot",
          "termpilot.exe"
        ]
      },
      {
        "from": "resources/uninstall-path.ps1",
        "to": "uninstall-path.ps1"
      },
      {
        "from": "resources/install-sftp.sh",
        "to": "install-sftp.sh"
      },
      {
        "from": "skills/termpilot",
        "to": "skills/termpilot"
      },
      {
        "from": "node_modules/@novnc/novnc/docs/LICENSE.MPL-2.0",
        "to": "licenses/novnc/LICENSE.MPL-2.0"
      },
      {
        "from": "node_modules/@novnc/novnc/docs/LICENSE.BSD-3-Clause",
        "to": "licenses/novnc/LICENSE.BSD-3-Clause"
      },
      {
        "from": "node_modules/@novnc/novnc/docs/LICENSE.BSD-2-Clause",
        "to": "licenses/novnc/LICENSE.BSD-2-Clause"
      },
      {
        "from": "node_modules/@novnc/novnc/docs/LICENSE.OFL-1.1",
        "to": "licenses/novnc/LICENSE.OFL-1.1"
      },
      {
        "from": "node_modules/ironrdp-wasm/LICENSE",
        "to": "licenses/ironrdp-wasm/LICENSE"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/@serialport/**",
      "**/node_modules/serialport/**"
    ],
    "npmRebuild": false,
    "icon": "resources/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "category": "Development",
      "maintainer": "TermPilot",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
