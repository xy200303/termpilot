{
  "name": "termpilot",
  "version": "0.5.3",
  "description": "TermPilot - Agent 可操控的 SSH 终端（XShell 风格 GUI + 内置 MCP Server）",
  "main": "out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "npm run cli:build && electron-vite build && electron-builder --publish never",
    "dist:win": "npm run cli:build && electron-vite build && electron-builder --win --publish never",
    "dist:mac": "npm run cli:build && electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "npm run cli:build && electron-vite build && electron-builder --linux --publish never",
    "cli:build": "node scripts/build-cli.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "material-icon-theme": "^5.38.1",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "ssh2": "^1.17.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "overrides": {
    "dompurify": "3.4.16"
  },
  "build": {
    "appId": "app.termpilot.desktop",
    "productName": "TermPilot",
    "executableName": "TermPilot",
    "copyright": "Copyright © TermPilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "cli/dist",
        "to": "cli",
        "filter": [
          "termpilot",
          "termpilot.exe"
        ]
      },
      {
        "from": "resources/uninstall-path.ps1",
        "to": "uninstall-path.ps1"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": true,
    "icon": "resources/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "category": "Development",
      "maintainer": "TermPilot",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
